[Unit]
# Fallback sweep: independent of the agent, of the WebUI, and of whether a wake was delivered.
# Every 2 minutes it checks all runs: restart a dead supervisor phase, and file an incident
# when a report was never read.
Description=hawkeye-v2 doctor (restart dead phases, raise incidents)
After=default.target

[Service]
Type=oneshot
# The four host-specific values are rendered by install.sh into your copy of this
# unit; the paths below are only the template defaults, kept readable on purpose.
# 1) HERMES_HOME           -> your Hermes home directory
# 2) HAWKEYE_V2_CONFIG     -> path to your hawkeye.toml (see config/hawkeye.toml.example)
# 3) HAWKEYE_KERNEL_SRC    -> path to your Hermes kernel source checkout (board-scenario path resolution)
# 4) ExecStart             -> the hk entry point of this repository, e.g. <REPO_DIR>/bin/hk
Environment=HERMES_HOME=/home/<user>/.hermes
Environment=HAWKEYE_V2_CONFIG=/opt/hawkeye/config/hawkeye.toml
Environment=HAWKEYE_KERNEL_SRC=/home/<user>/src/hermes
ExecStart=/opt/hawkeye/bin/hk doctor --fix
# Exit code 1 means "an incident exists" (so `systemctl --user status` shows it at a glance);
# it is not a failure and must not flood the journal.
SuccessExitStatus=0 1
TimeoutStartSec=120
# Default KillMode=control-group signals every process left in the unit's cgroup when the
# oneshot main process exits -- including the phase doctor just spawned to revive a run
# (start_new_session detaches the session, not the cgroup). The restart then dies in the
# same instant it is recorded.
KillMode=process
